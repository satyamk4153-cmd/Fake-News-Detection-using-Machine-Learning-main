# ==============================================================================
# TruthLens — Environment Configuration Specification (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control. In production, provide these
# values through a secure secret manager (AWS Secrets Manager, GCP Secret Manager,
# HashiCorp Vault, or Kubernetes Secrets).
# ==============================================================================

# Application Environment
APP_NAME=TruthLens
APP_ENV=development                      # 'development', 'staging', or 'production'
DEBUG=False                              # Set to False in production
API_V1_PREFIX=/api/v1

# Security & Cryptography
# Generate a secure 64-character hex key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_KEY_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# Local development default (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./truthlens.db
# Production PostgreSQL example (using asyncpg):
# DATABASE_URL=postgresql+asyncpg://truthlens_user:STRONG_PASSWORD@localhost:5432/truthlens_db

# Cache / Optional Redis (In-memory fallback automatically engaged if Redis unavailable)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting (Requests per minute)
RATE_LIMIT_PER_MINUTE_ANONYMOUS=30
RATE_LIMIT_PER_MINUTE_AUTH=120
RATE_LIMIT_PER_MINUTE_ADMIN=300

# Machine Learning & Inference Subsystem
MODEL_DIR=ml/artifacts
ACTIVE_MODEL_VERSION=ensemble-v1.0
UNCERTAINTY_THRESHOLD_LOW=0.35
UNCERTAINTY_THRESHOLD_HIGH=0.65
MIN_ARTICLE_LENGTH=50
MAX_ARTICLE_LENGTH=50000
MIN_HEADLINE_LENGTH=15
MAX_HEADLINE_LENGTH=500

# Security & SSRF Protection
MAX_URL_REDIRECTS=3
URL_REQUEST_TIMEOUT_SECONDS=8
MAX_URL_CONTENT_BYTES=5242880           # 5 MB

# CORS Allowed Origins (JSON list of URLs)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional External Search & Fact-Checking Provider
# Supported: 'wikipedia' (default, free open API), 'disabled', or 'custom'
SEARCH_PROVIDER=wikipedia
SEARCH_TIMEOUT_SECONDS=5
