FROM python:3.12-slim

# Install system dependencies and security tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged application user
RUN groupadd -g 1001 truthlens && \
    useradd -u 1001 -g truthlens -m -s /bin/bash truthlens

WORKDIR /app

# Copy dependency specifications first for layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY . .

# Generate and verify model artifacts during build
RUN python -m ml.training.train

# Ensure non-root ownership of application files and directories
RUN chown -R truthlens:truthlens /app

USER truthlens

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health/ready || exit 1

CMD ["uvicorn", "apps.api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
